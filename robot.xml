<mujoco model="self_balancing_robot">
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <geom condim="3" friction="1 0.5 0.01"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="2 2 2" dir="-1 -1 -1" diffuse="0.4 0.4 0.4"/>
    <camera pos="0 -2 1.2" xyaxes="1 0 0 0 0.45 0.89" fovy="50"/>

    <geom name="ground" type="plane" size="5 5 0.1" rgba=".9 .9 .9 1"/>

    <!-- Chassis: compact box sitting above wheels -->
    <body name="chassis" pos="0 0 0.135">
      <freejoint name="chassis_free"/>
      <geom name="chassis_geom" type="box" size="0.10 0.075 0.075" mass="2.0" rgba=".2 .5 .8 1"/>

      <!-- Left wheel: bottom at z=0 (ground), offset to side -->
      <body name="left_wheel" pos="0 0.0925 -0.075">
        <joint name="left_wheel_hinge" type="hinge" axis="0 1 0"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.06 0.0175" mass="0.3" euler="-90 0 0" rgba=".15 .15 .15 1"/>
      </body>

      <!-- Right wheel: bottom at z=0 (ground), offset to side -->
      <body name="right_wheel" pos="0 -0.0925 -0.075">
        <joint name="right_wheel_hinge" type="hinge" axis="0 1 0"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.06 0.0175" mass="0.3" euler="-90 0 0" rgba=".15 .15 .15 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_motor"
           joint="left_wheel_hinge"
           gear="1"
           ctrlrange="-10 10"/>

    <motor name="right_motor"
           joint="right_wheel_hinge"
           gear="1"
           ctrlrange="-10 10"/>
  </actuator>
</mujoco>
